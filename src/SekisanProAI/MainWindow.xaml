<Window x:Class="SekisanProAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEKISAN PRO AI" Height="760" Width="1220"
        MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#16212D">
            <StackPanel Margin="18">
                <TextBlock Text="SEKISAN" Foreground="White" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="PRO AI" Foreground="#53C7FF" FontSize="20" Margin="0,0,0,28"/>
                <Button Content="🏠  ホーム" Click="Home_Click"/>
                <Button Content="🔎  単価検索" Click="Price_Click"/>
                <Button Content="🔄  Golden River同期" Click="Sync_Click"/>
                <Button Content="🗂  単価履歴" Click="History_Click"/>
                <Separator Margin="0,20"/>
                <TextBlock Text="状態" Foreground="#9FB0BF" FontWeight="Bold"/>
                <TextBlock x:Name="SidebarStatus" Text="準備完了" Foreground="White" TextWrapping="Wrap" Margin="0,8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid x:Name="HomePanel">
                <StackPanel>
                    <TextBlock Text="公共工事 積算AI" FontSize="32" FontWeight="Bold" Foreground="#16212D"/>
                    <TextBlock Text="Golden River単価を基準に、迷わず確認できる積算環境" FontSize="16" Foreground="#607080" Margin="0,6,0,24"/>
                    <WrapPanel>
                        <Button Width="260" Height="100" Content="＋  新しい工事を積算" FontSize="18" IsEnabled="False" ToolTip="次版で設計書解析を追加"/>
                        <Button Width="260" Height="100" Content="🔎  Golden River単価検索" FontSize="18" Click="Price_Click"/>
                        <Button Width="260" Height="100" Content="🔄  単価を同期する" FontSize="18" Click="Sync_Click"/>
                    </WrapPanel>
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="5,25">
                        <StackPanel>
                            <TextBlock Text="現在の単価データ" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="CurrentVersionText" Text="まだ単価データがありません。" Margin="0,12,0,0" FontSize="15"/>
                            <TextBlock Text="※ Golden RiverからExcel/CSV出力したファイルを同期フォルダへ保存してください。" Foreground="#677788" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="PricePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Golden River 単価検索" FontSize="28" FontWeight="Bold"/>
                <DockPanel Grid.Row="1" Margin="0,15">
                    <TextBox x:Name="SearchBox" Width="520" Height="42" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
                    <Button Content="検索" Width="100" Click="Search_Click"/>
                </DockPanel>
                <DataGrid Grid.Row="2" x:Name="PriceGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="コード" Binding="{Binding Code}" Width="140"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="規格" Binding="{Binding Spec}" Width="2*"/>
                        <DataGridTextColumn Header="単位" Binding="{Binding Unit}" Width="80"/>
                        <DataGridTextColumn Header="単価" Binding="{Binding Price, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="地区" Binding="{Binding Region}" Width="110"/>
                        <DataGridTextColumn Header="出典" Binding="{Binding Source}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="SyncPanel" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Golden River 単価同期" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Golden Riverから出力したCSV / Excelを、このフォルダへ保存すると自動取込します。" Margin="0,10,0,15"/>
                    <DockPanel>
                        <TextBox x:Name="FolderBox" Height="42" VerticalContentAlignment="Center"/>
                        <Button Content="フォルダ選択" Width="130" Click="ChooseFolder_Click"/>
                    </DockPanel>
                    <WrapPanel Margin="0,15">
                        <Button Content="今すぐ同期" Width="150" Click="Scan_Click"/>
                        <Button Content="ファイルを直接取込" Width="170" Click="ImportFile_Click"/>
                        <Button Content="設定を保存" Width="140" Click="SaveFolder_Click"/>
                    </WrapPanel>
                    <Border Background="White" Padding="18" CornerRadius="8" Margin="0,20">
                        <TextBlock x:Name="SyncStatus" Text="同期待機中" TextWrapping="Wrap" FontSize="15"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="単価更新履歴" FontSize="28" FontWeight="Bold"/>
                <DataGrid Grid.Row="1" x:Name="VersionGrid" Margin="0,15,0,0" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="取込日時" Binding="{Binding ImportedAt}" Width="170"/>
                        <DataGridTextColumn Header="ラベル" Binding="{Binding Label}" Width="2*"/>
                        <DataGridTextColumn Header="件数" Binding="{Binding RecordCount}" Width="100"/>
                        <DataGridTextColumn Header="元ファイル" Binding="{Binding SourceFile}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>